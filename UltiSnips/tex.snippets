\begin{gather*}
    $1 \\\\
    $0
\end{gather*}
endsnippet

context "math()"
snippet til "Tilde" iA
\tilde{${1:${VISUAL}}}$0
endsnippet

context "math()"
snippet subs "Substack" iA
\substack{${1:riga 1} \\\\ ${2:riga 2}}$0
endsnippet


context "math()"
snippet leb "lebesgue sign" iA
\mathscr{L}
endsnippet

context "math()"
snippet bino "Coefficiente binomiale" iA
\binom{${1:n}}{${2:k}}$0
endsnippet

context "math()"
snippet lps "Convergenza forte in Lp" iA
\xrightarrow{L^{${1:p}} \text{ forte}} $0
endsnippet

context "math()"
snippet lpw "Convergenza debole" iA
\rightharpoonup $0
endsnippet

context "math()"
snippet cqo "Convergenza quasi ovunque" iA
\xrightarrow{q.o.} $0
endsnippet

context "math()"
snippet cinm "Convergenza in misura" iA
\xrightarrow{\text{in misura}} $0
endsnippet


context "math()"
snippet cunif "Convergenza uniforme" iA
\rightrightarrows $0
endsnippet

context "math()"
snippet sotto "Fa scrivere sotto" iA
\underset{$1}{$2} $0
endsnippet

# Snippet per il prodotto scalare
context "math()"
snippet pscal "Prodotto scalare con parentesi angolate" iA
\langle ${1:u}, ${2:v} \rangle $0
endsnippet

context "math()"
snippet ptrian "Prodotto scalare con parentesi angolate" iA
\langle ${1:u} \rangle $0
endsnippet

context "math()"
snippet restr "Restrizione di una funzione" iA
\left. ${1} \right|_{${2}} ${0}
endsnippet

context "math()"
snippet comp "Simbolo composizione" iA
\circ $0
endsnippet

context "math()"
snippet ast "Simbolo convoluzione" iA
\ast $0
endsnippet

snippet initchap "Simbolo composizione" iA
%!TEX root = ../main.tex
$0
endsnippet

context "math()"
snippet ring "Simbolo di interno (mathring)" w
\mathrel{\mathring{${1:${VISUAL}}}}$0
endsnippet

context "math()"
snippet cauchy "Problema di Cauchy" w
\begin{cases} 
y'(x) = f(x, y(x)), & x \ge x_0 \\\ 
y(x_0) = y_0 
\end{cases}
$0
endsnippet



snippet alg "Ambiente Algoritmo" b
\begin{myalgorithm}{${1:Titolo}}{${2:etichetta_per_ref}}
\begin{algorithmic}[1]
	\Require ${3:Grafo $G = (V, E)$}
	\Ensure ${4:Risultato}
	\Statex
	${0:\State }
\end{algorithmic}
\end{myalgorithm}
endsnippet

context "in_alg()"
snippet st "\State" bA
\State ${0}
endsnippet

context "in_alg()"
snippet for "Ciclo For" bA
\For{${1:condizione}}
	\State ${0}
\EndFor
endsnippet

context "in_alg()"
snippet wh "Ciclo While" bA
\While{${1:condizione}}
	\State ${0}
\EndWhile
endsnippet

context "in_alg()"
snippet if "Blocco If" bA
\If{${1:condizione}}
	\State ${0}
\EndIf
endsnippet

context "in_alg()"
snippet ife "Blocco If / Else" bA
\If{${1:condizione}}
	\State ${2}
\Else
	\State ${0}
\EndIf
endsnippet

context "in_alg()"
snippet ret "Return" bA
\State \Return ${0}
endsnippet

context "in_alg()"
snippet com "Commento Algoritmo" iA
\Comment{${1:spiegazione}} ${0}
endsnippet

context "in_alg()"
snippet <- "Assegnamento" iA
\leftarrow ${0}
endsnippet

# Bonus: Se digiti != diventa automaticamente \neq
context "in_alg()"
snippet != "Diverso" iA
\neq ${0}
endsnippet

snippet @@ "Diverso" iA
ó
endsnippet

