# vim:ft=snippets
# new config 

global !p
def math():
	return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment(): 
	return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
	[x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
	return x != '0' and y != '0'

def in_alg():
    # Legge il file all'indietro dalla posizione del cursore
    for i in range(snip.line, -1, -1):
        line = snip.buffer[i]
        if '\\begin{algorithmic}' in line:
            return True
        if '\\end{algorithmic}' in line:
            return False
    return False

endglobal


snippet template "pro notes template" b
\documentclass[12pt, a4paper, oneside]{report}

\usepackage{uni-notes} 

% --- CONFIGURAZIONE TEMA ---
% #1 Colore HEX (es. 9b0014)
% #2 Colore testo titoli (white o black)
\definecolor{mytheme}{HTML}{${3:9b0014}} \settheme{mytheme}{${4:black}} 

\usepackage[Bjarne]{fncychap} 

\begin{document}

\makeunipdcover{${1:Titolo del Corso}}{Lezioni del Prof. ${2:}}{Leonardo Michielon}{2025/2026}

\tableofcontents
\newpage

$0

\end{document}
endsnippet

