# --- PARENTESI E MATRICI ---

context "math()"
snippet () "left( right)" iA
\\left( ${1:${VISUAL}} \\right) $0
endsnippet

context "math()"
snippet pmat "pmat" iA
\\begin{pmatrix} $1 \\end{pmatrix} $0
endsnippet

context "math()"
snippet bmat "bmat" iA
\\begin{bmatrix} $1 \\end{bmatrix} $0
endsnippet

# --- ANALISI E PROBABILITÀ ---

context "math()"
snippet sum "sum" w
\\sum_{${1:n}=${2:1}}^{${3:\\infty}} ${4:a_$1} $0
endsnippet

context "math()"
snippet lim "limit" w
\\lim_{${1:n} \\to ${2:\\infty}} 
endsnippet

context "math()"
snippet dint "integral" wA
\\int_{${1:-\\infty}}^{${2:\\infty}} ${3:${VISUAL}} $0
endsnippet

context "math()"
snippet sq "\sqrt{}" iA
\\sqrt{${1:${VISUAL}}} $0
endsnippet

context "math()"
snippet RR "real" iA
\\mathbb{R}
endsnippet

context "math()"
snippet NN "natural" iA
\\mathbb{N}
endsnippet

context "math()"
snippet EE "exists" iA
\\exists 
endsnippet

context "math()"
snippet AA "forall" iA
\\forall 
endsnippet

context "math()"
snippet inn "in" iA
\\in 
endsnippet

context "math()"
snippet mcal "mathcal" iA
\\mathcal{$1}$0
endsnippet
